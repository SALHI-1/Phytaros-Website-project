# ==============================================================================
# Option 1 — Production on Google Cloud Run (Recommended: Resend HTTP API)
# ==============================================================================
RESEND_API_KEY=

# ==============================================================================
# Option 2 — Local Dev / Staging (Mailtrap Sandbox or any SMTP server)
# Used automatically when RESEND_API_KEY is empty.
# ==============================================================================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Sender & Admin Recipient
# ==============================================================================
EMAIL_FROM="Phytaros <orders@phytaros.com>"
ADMIN_EMAIL="hello@phytaros.com"

# Optional: set to "true" to force dry-run (console logging only)
EMAIL_DRY_RUN="false"
