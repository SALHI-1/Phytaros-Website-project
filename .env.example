# Email provider (Resend - https://resend.com)
# Leave empty during local UI development to run in dry-run mode (logs emails to console).
RESEND_API_KEY=

# Sender email verified in Resend (e.g. "Phytaros Pre-Orders <orders@phytaros.com>")
EMAIL_FROM="Phytaros <onboarding@resend.dev>"

# Boss / Admin email where all pre-order and inquiry notifications are sent
ADMIN_EMAIL="hello@phytaros.com"

# Optional: set to "true" to simulate email sending without hitting Resend (useful for staging/testing)
EMAIL_DRY_RUN="false"
